#include <stdio.h>
#include <conio.h>

void imprimirArr(int A[],int n){
    
    int k=0;
    while(k<n){
        printf("%d  ", A[k]);
        k++;
    }
}



int main()
{
    int A[]={45,23,15,-19,-31};
    
    int n=5;
    int i=0;
    int j;
    int aux;
    for(j=i+1;j<=n-1;j++){
        
        printf("Comparacion entre A[%d] y A[%d] \n",i,j);
        if(A[i]>A[j]){
            aux=A[i];
            A[i]=A[j];
            A[j]=aux;
        }
        imprimirArr(A,n);
        printf("\n");
    }
}
