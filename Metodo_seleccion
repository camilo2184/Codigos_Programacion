#include <stdio.h>


void imprimirArreglo(int A[], int n) {
    int k = 0;
    while (k < n) {
        printf("%d  ", A[k]);
        k++;
    }
    printf("\n");
}


void intercambiar(int A[], int pos1, int pos2) {
    int aux = A[pos1];
    A[pos1] = A[pos2];
    A[pos2] = aux;
}


void ordenarSeleccion(int A[], int n) {
    int i, j;
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            printf("Comparacion entre A[%d] y A[%d]\n", i, j);
            if (A[i] > A[j]) {
                intercambiar(A, i, j);
            }
            imprimirArreglo(A, n);
        }
        printf(" Fin de la pasada %d ---\n\n", i + 1);
    }
}

int main() {
    int A[] = {45, 23, 15, -19, -31};
    int n = 5;

    printf("Arreglo inicial:\n");
    imprimirArreglo(A, n);
    printf("\n Inicio del ordenamiento ---\n");

    ordenarSeleccion(A, n);

    printf("Arreglo final ordenado:\n");
    imprimirArreglo(A, n);

    return 0;
}

